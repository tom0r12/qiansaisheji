# Run with Library Compiler 2022.03, NOT dc_shell.
# Shared inputs remain read-only. Generated databases stay beside this script.
namespace eval ::qingyu_sram_build {
    variable root /storage1/admin_public_dir/SRAM_Lib_2025
    variable out [file join [file dirname [file normalize [info script]]] qingyu_sram_db]
    file mkdir $out
    set jobs {}
    foreach macro {RAMSP128X16 RAMSP1024X16 RAMSP4096X16} {
        set name ${macro}_tt_1p10v_1p10v_25c
        set source [file join $root $macro lib ${name}.lib]
        if {![file readable $source]} { error "Missing/unreadable Liberty file: $source" }
        lappend jobs [list $name $source]
    }
    set outputs {}
    foreach job $jobs {
        foreach {name source} $job break
        puts "QINGYU: Reading $source"
        set status [read_lib $source]
        if {$status eq "0"} { error "read_lib failed for $name; inspect preceding diagnostics" }
        # Unique temporary name prevents accepting an old database as new output.
        set temp [file join $out ${name}.[pid].[clock clicks].db]
        set status [write_lib $name -format db -output $temp]
        if {$status eq "0" || ![file isfile $temp]} {
            error "write_lib failed for $name; inspect preceding diagnostics"
        }
        if {[file size $temp] == 0} { error "Empty output database: $temp" }
        set destination [file join $out ${name}.db]
        file rename -force $temp $destination
        lappend outputs $destination
        puts "QINGYU_DB_CREATED: $destination ([file size $destination] bytes)"
    }
    set config [file join $out sram_libs.tcl]
    set stream [open $config w]
    puts $stream {# Generated by build_sram_db.tcl. Source in DC before synthesis setup.}
    puts $stream [list set env(QINGYU_SRAM_LIBS) $outputs]
    close $stream
    puts "QINGYU_SRAM_DB_BUILD_COMPLETE: [llength $outputs] databases"
    puts "QINGYU_CONFIG: $config"
    puts "Library conversion only. Review warnings; DC linking, macro simulation and timing remain pending."
}
